# Copy this file to .env and fill in the real values.
#   cp .env.example .env
# .env is gitignored. This example file is not — keep it free of real keys.

# Firebase Admin — path to the service account JSON (server side: token check).
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_KEY=./serviceAccountKey.json

# Firebase Web SDK — the browser needs these three to run email/password login.
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# OpenAI — https://platform.openai.com/api-keys
# Only score generation uses it; sign-in works without it.
OPENAI_API_KEY=
# Optional. gpt-6-sol is the default; gpt-6-astra writes better and costs ~5x more.
OPENAI_MODEL=gpt-6-sol
# Optional: none / low / medium / high. Higher thinks longer before writing.
OPENAI_REASONING_EFFORT=medium

# Flask session signing. Any long random string:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# macOS holds 5000 for AirPlay and Music Aura sits on 5001.
PORT=5002
